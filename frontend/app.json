{
  "expo": {
    "name": "glum",
    "slug": "glum",
    "version": "1.0.0",
    "scheme": "glum",
    "orientation": "portrait",
    "platforms": ["android"],
    "newArchEnabled": true,
    "android": {
      "package": "com.anna.glum",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset"
    ]
  }
}
